# Copier ce fichier en .env.local et remplir les valeurs.

# Clé OpenRouteService (https://openrouteservice.org/dev/#/signup).
# Côté serveur uniquement : ne jamais la préfixer par NEXT_PUBLIC_.
ORS_API_KEY=

# Clé MapTiler (https://cloud.maptiler.com/account/keys/).
# Exposée au navigateur : la restreindre aux domaines du site dans le tableau de bord MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=

# URL publique du site, sans slash final (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
